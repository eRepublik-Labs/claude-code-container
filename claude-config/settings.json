{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "outputStyle": "Explanatory",
  "extraKnownMarketplaces": {
    "beads": {
      "source": {
        "source": "github",
        "repo": "steveyegge/beads"
      }
    },
    "hex-plugins": {
      "source": {
        "source": "github",
        "repo": "hex/claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "claude-council@hex-plugins": true,
    "claude-image-generation@hex-plugins": true,
    "claude-guard@hex-plugins": true,
    "claude-tmux@hex-plugins": true
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "MAX_THINKING_TOKENS": "31999",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6"
  },
  "includeCoAuthoredBy": false,
  "disabledTools": ["NotebookEdit", "NotebookRead"],
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm|pnpm|yarn|cargo|pytest)\"",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"$TMUX\" ]; then echo '[Hook] Consider tmux for session persistence' >&2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/aboutme-validator.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": []
  },
  "statusLine": {
    "type": "command",
    "command": "claude-powerline --style=powerline --theme=tokyo-night",
    "padding": 0
  },
  "alwaysThinkingEnabled": true
}
